{
  "name": "agent-card-tool-coverage",
  "version": "0.1.0",
  "description": "Conformance check between an A2A AgentCard's declared tools and an MCP server's actual tools/list. Reports missing (declared but not exposed), undeclared (exposed but not in card), and matched tools; counts by side-effect class. Library + CLI.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "mizcausevic-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizcausevic-dev/agent-card-tool-coverage"
  },
  "keywords": [
    "a2a",
    "agent-cards",
    "mcp",
    "conformance",
    "governance",
    "ai-governance",
    "typescript"
  ],
  "bin": {
    "agent-card-tool-coverage": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "demo": "tsx src/cli.ts --card fixtures/card.json --tools fixtures/tools-list-conformant.json --format summary",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
